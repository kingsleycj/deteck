{
	"name": "@deteck/core",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "DETECK's business rules, database and outside-service connections, shared by the web app and the worker.",
	"exports": {
		"./tests/*": "./tests/*",
		"./scripts/*": "./scripts/*",
		"./*": "./src/*"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"test:unit": "vitest run --project unit",
		"test:db": "vitest run --project db",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
		"db:seed": "node --env-file-if-exists=../../.env scripts/seed.ts",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/server/auth-cli.ts --output src/server/db/auth.schema.ts --yes",
		"staff:create": "node --env-file-if-exists=../../.env scripts/create-staff.ts",
		"eval:scan": "node --env-file-if-exists=../../.env scripts/eval-scan.ts",
		"demo:accounts": "node --env-file-if-exists=../../.env scripts/demo-accounts.ts",
		"demo:code": "node scripts/demo-code.ts",
		"db:reset": "node --env-file-if-exists=../../.env scripts/reset-dev.ts",
		"test-codes": "node scripts/make-test-codes.ts",
		"backup": "node --env-file-if-exists=../../.env scripts/backup.ts",
		"restore": "node --env-file-if-exists=../../.env scripts/restore.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.3.0",
		"@aws-sdk/client-s3": "^3.1156.0",
		"@aws-sdk/s3-request-presigner": "^3.1156.0",
		"@sentry/node": "^11.9.0",
		"better-auth": "^1.6.24",
		"csv-parse": "^7.0.3",
		"drizzle-orm": "^0.45.2",
		"exceljs": "^4.4.0",
		"pg-boss": "^12.38.0",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5",
		"undici": "7.30.1",
		"zod": "^4.6.7",
		"zxing-wasm": "^3.1.6"
	},
	"devDependencies": {
		"@types/node": "^24",
		"@types/qrcode": "^1.5.6",
		"auth": "^1.6.24",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
