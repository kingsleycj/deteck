{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"erasableSyntaxOnly": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["node"]
	},
	"include": ["src"]
}
