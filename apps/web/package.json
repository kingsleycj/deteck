{
	"name": "@deteck/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "The DETECK website: landing page, public checker, manufacturer workspace, DETECK console and the REST API.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=../../.env build/index.js",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:e2e": "playwright test",
		"budget": "node scripts/check-budget.ts",
		"screenshots": "playwright test -c playwright.walkthrough.config.ts"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@deteck/core": "workspace:*",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/plus-jakarta-sans": "5.3.0",
		"better-auth": "^1.6.24",
		"csv-parse": "^7.0.3",
		"drizzle-orm": "^0.45.2",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@types/qrcode": "^1.5.6",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	}
}
