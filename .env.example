# Copy to .env for local development. Production values live in Render's environment settings.

# Database (docker compose exposes Postgres on 5435)
DATABASE_URL="postgres://deteck:deteck@localhost:5435/deteck"
TEST_DATABASE_URL="postgres://deteck:deteck@localhost:5435/deteck_test"

# Background jobs: "true" runs them inside the web app (simplest for local work).
# In production set "false" and run the worker app (pnpm worker) as its own service.
JOBS_IN_WEB="true"

# Public origin of the app, used for links in emails and by Better Auth
ORIGIN="http://localhost:5173"

# Secrets: generate each with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Key for hashing serials. Changing it makes every stored serial unreadable, so keep it safe.
SERIAL_HMAC_KEY=""
# Salt for the daily-rotated anonymous device hash
DEVICE_HASH_SECRET=""

# File storage: "local" (disk, development) or "s3" (Cloudflare R2 in production)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/uploads"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email: "log" (prints to the console) or "resend"
EMAIL_DRIVER="log"
EMAIL_FROM="DETECK <no-reply@localhost>"
RESEND_API_KEY=""

# Packaging scan AI: "off", "pilot" (only browsers that opened /pilot/<PILOT_ACCESS_CODE>) or "public"
FEATURE_PACKAGING_AI="off"
ANTHROPIC_API_KEY=""
SCAN_MODEL="claude-opus-5-5"

# Rate limits for public checks
RATE_LIMIT_DEVICE_PER_MINUTE="10"
RATE_LIMIT_DEVICE_PER_HOUR="60"
RATE_LIMIT_IP_PER_HOUR="300"
SCAN_LIMIT_DEVICE_PER_DAY="5"
# Packaging checks per IP address per day (each one is a paid AI call)
SCAN_LIMIT_IP_PER_DAY="50"

# Code that unlocks pilot-only features in a browser: visit /pilot/<code>
PILOT_ACCESS_CODE=""

# Public contact and support inbox (OQ-12). Until set, pages link to manufacturer registration instead.
CONTACT_EMAIL=""

# ---------------------------------------------------------------- outside services
# Each is optional locally; the feature switches itself off when its keys are empty.
# docs/SETUP-KEYS.md explains where every key comes from.

# Sentry error tracking
SENTRY_DSN=""

# Cloudflare Turnstile ("are you human?" check after rate limits)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# WhatsApp Cloud API (recall alerts by WhatsApp)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_TEMPLATE_SUBSCRIBED="deteck_alert_subscribed"
WHATSAPP_TEMPLATE_RECALL="deteck_recall_alert"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Public REST API: requests per hour per IP without a key
API_ANONYMOUS_PER_HOUR="300"

# Languages on the public pages (English, Nigerian Pidgin, Hausa, Yoruba, Igbo).
# Empty: all five on your machine, English only in production.
LANGUAGES="en,pcm,ha,yo,ig"

# Production only: a secret Cloudflare adds to every request (x-deteck-edge header). When set,
# requests that skip Cloudflare are refused. Leave empty locally.
EDGE_SECRET=""

# Database connections each process may open
DATABASE_POOL_MAX="10"

# Nightly backups (pnpm backup): a separate R2 bucket. BACKUP_S3_* fall back to the S3_* values.
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""

# End-to-end tests (Playwright) use their own database
E2E_DATABASE_URL="postgres://deteck:deteck@localhost:5435/deteck_e2e"
